{
  "expo": {
    "name": "HANE",
    "slug": "hane",
    "version": "0.5.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "hane",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#020304",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hane.finance",
      "infoPlist": {
        "NSFaceIDUsageDescription": "HANE uygulamasını güvenli şekilde açmak için Face ID kullanılabilir."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "HANE",
      "shortName": "HANE",
      "themeColor": "#06111C",
      "backgroundColor": "#06111C"
    },
    "plugins": [
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HANE, fiş ve fatura belgelerini yalnızca cihazında kaydetmek için fotoğraflarına erişir.",
          "cameraPermission": "HANE, fiş ve fatura fotoğrafı çekmek için kamerana erişir.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
